doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title #{title || 'ShopVN - Phụ Kiện Xa Xỉ'}

    //- Tailwind CSS
    script(src="https://cdn.tailwindcss.com")

    script.
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: '#000000',
            }
          }
        }
      }

    //- Custom CSS
    link(rel="stylesheet", href="/css/style.css")

    block head

  body(class="bg-white font-sans")
    block content

    block scripts
