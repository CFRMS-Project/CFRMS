extends ../layouts/customer.pug

block content
  div(class="min-h-screen bg-slate-50 p-8")
    div(class="max-w-7xl mx-auto")
      //- Welcome Banner
      div(class="bg-white rounded-2xl shadow-sm border border-slate-100 p-8 mb-8")
        div(class="flex items-center justify-between")
          div
            h1(class="text-2xl font-bold text-slate-800 mb-2") 🛡️ Admin Dashboard
            p(class="text-slate-500 text-sm") Trang quản trị hệ thống CFRMS - ShopVN
          div(class="flex items-center gap-3")
            a(href="/logout" class="bg-red-500 hover:bg-red-600 text-white px-5 py-2 rounded-full text-xs font-bold transition-all") Đăng xuất

      //- Cards
      div(class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8")
        div(class="bg-white rounded-xl shadow-sm p-6 border border-slate-100")
          p(class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2") Tổng đánh giá
          p(class="text-3xl font-black text-slate-800") --
        div(class="bg-white rounded-xl shadow-sm p-6 border border-slate-100")
          p(class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2") Chờ duyệt
          p(class="text-3xl font-black text-orange-500") --
        div(class="bg-white rounded-xl shadow-sm p-6 border border-slate-100")
          p(class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2") Người dùng
          p(class="text-3xl font-black text-blue-600") --

      //- Placeholder
      div(class="bg-white rounded-2xl shadow-sm border border-slate-100 p-12 text-center")
        p(class="text-6xl mb-4") 🚧
        h2(class="text-xl font-bold text-slate-700 mb-2") Đang phát triển
        p(class="text-slate-400 text-sm") Trang Dashboard Admin sẽ được hoàn thiện trong phiên bản tiếp theo.
