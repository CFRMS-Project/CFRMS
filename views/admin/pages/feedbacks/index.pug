extends ../../layouts/default.pug

block styles
  style.
    .feedbacks-actions button {
      text-transform: none !important;
    }

    .feedbacks-actions button:last-child {
      color: #000000 !important;
    }

block content
  - var activePage = 'reviews'
  - const currentTab = (filters && filters.tab) ? filters.tab : 'pending'
  - const currentPage = Number((pagination && pagination.page) ? pagination.page : ((filters && filters.page) ? filters.page : 1))
  - const totalPages = Math.max(1, Number((pagination && pagination.totalPages) ? pagination.totalPages : 1))
  - const pendingCount = Number((tabCounts && tabCounts.pending) ? tabCounts.pending : 0)
  - const approvedCount = Number((tabCounts && tabCounts.approved) ? tabCounts.approved : 0)
  - const rejectedCount = Number((tabCounts && tabCounts.rejected) ? tabCounts.rejected : 0)
  - const allCount = Number((tabCounts && tabCounts.all) ? tabCounts.all : 0)
  - const safeQuery = (filters && filters.q) ? filters.q : ''

  //- 1. THANH TÌM KIẾM

  div(class='mb-8')
    form(class='relative' method='GET' action='/admin/feedbacks')
      input(type='hidden' name='tab' value=currentTab)
      span(class='absolute inset-y-0 left-0 flex items-center pl-4')
        //- Đã thay bằng icon FontAwesome mới, thêm fill-current để ăn theo màu text-gray-400
        svg(xmlns='http://www.w3.org/2000/svg' class='h-4 w-4 text-gray-400 fill-current' viewBox='0 0 512 512')
          path(d='M416 208c0 45.9-14.9 88.3-40 122.7L502.6 457.4c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L330.7 376C296.3 401.1 253.9 416 208 416 93.1 416 0 322.9 0 208S93.1 0 208 0 416 93.1 416 208zM208 352a144 144 0 1 0 0-288 144 144 0 1 0 0 288z')
      //- Đã xóa nút Tìm và chỉnh lại padding right (pr-4)
      input(class='w-full bg-white border border-gray-100 rounded-full py-3 pl-11 pr-4 text-sm text-gray-600 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-100' type='text' name='q' value=safeQuery placeholder='Tìm kiếm đánh giá, khách hàng...' onkeypress='if(event.key === "Enter") this.form.submit()')

  //- 2. THẺ THỐNG KÊ
  div(class='grid grid-cols-1 md:grid-cols-3 gap-6 mb-8')
    div(class='bg-white p-6 rounded-3xl border border-gray-100 shadow-sm')
      div(class='flex justify-between items-start mb-4')
        div(class='w-12 h-12 rounded-full bg-orange-50 flex items-center justify-center text-orange-500')
          svg(xmlns='http://www.w3.org/2000/svg' class='h-6 w-6' fill='none' viewBox='0 0 24 24' stroke='currentColor')
            path(stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4')
      p(class='text-sm font-semibold text-gray-500 mb-1') Đang chờ duyệt
      h3(class='text-4xl font-extrabold text-gray-900')= (stats && stats.pendingCount) ? stats.pendingCount : 0

    div(class='bg-white p-6 rounded-3xl border border-gray-100 shadow-sm')
      div(class='flex justify-between items-start mb-4')
        div(class='w-12 h-12 rounded-full bg-green-50 flex items-center justify-center text-green-500')
          svg(xmlns='http://www.w3.org/2000/svg' class='h-6 w-6' fill='none' viewBox='0 0 24 24' stroke='currentColor')
            path(stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z')
      p(class='text-sm font-semibold text-gray-500 mb-1') Đã duyệt hôm nay
      h3(class='text-4xl font-extrabold text-gray-900')= (stats && stats.approvedTodayCount) ? stats.approvedTodayCount : 0

    div(class='bg-white p-6 rounded-3xl border border-gray-100 shadow-sm')
      div(class='flex justify-between items-start mb-4')
        div(class='w-12 h-12 rounded-full bg-red-50 flex items-center justify-center text-red-500')
          svg(xmlns='http://www.w3.org/2000/svg' class='h-6 w-6' fill='none' viewBox='0 0 24 24' stroke='currentColor')
            path(stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z')
      p(class='text-sm font-semibold text-gray-500 mb-1') Tỉ lệ vi phạm
      h3(class='text-4xl font-extrabold text-gray-900')= `${Number((stats && stats.violationRate) ? stats.violationRate : 0).toFixed(1)}%`

  //- 3. BẢNG KIỂM DUYỆT
  div(class='bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden')
    div(class='p-6 flex justify-between items-center')
      h2(class='text-xl font-bold text-gray-900') Danh sách kiểm duyệt đánh giá
      div(class='flex gap-3 feedbacks-actions')
        button(class='btn btn-sm h-9 px-4 border-none text-white hover:opacity-90 font-medium' style='background-color:#3067DF; border-radius: 16px;' type='button') Duyệt hàng loạt
        button(
              class='btn btn-sm h-9 px-4 border-none text-gray-700 !font-normal !normal-case' 
              style='background-color:#F1F5F9; border-radius: 16px;' 
              type='button'
            ) Xuất báo cáo
        
    div(class='flex gap-8 px-6 border-b border-gray-100 text-sm overflow-x-auto')
      a(class=`py-4 whitespace-nowrap ${currentTab === 'pending' ? 'font-bold text-blue-600 border-b-2 border-blue-600' : 'font-semibold text-gray-500 hover:text-gray-800'}` href=`/admin/feedbacks?tab=pending&q=${encodeURIComponent(safeQuery)}`) Chưa xử lý (#{pendingCount})
      a(class=`py-4 whitespace-nowrap ${currentTab === 'approved' ? 'font-bold text-blue-600 border-b-2 border-blue-600' : 'font-semibold text-gray-500 hover:text-gray-800'}` href=`/admin/feedbacks?tab=approved&q=${encodeURIComponent(safeQuery)}`) Đã xử lý (#{approvedCount})
      a(class=`py-4 whitespace-nowrap ${currentTab === 'rejected' ? 'font-bold text-blue-600 border-b-2 border-blue-600' : 'font-semibold text-gray-500 hover:text-gray-800'}` href=`/admin/feedbacks?tab=rejected&q=${encodeURIComponent(safeQuery)}`) Bị từ chối (#{rejectedCount})
      a(class=`py-4 whitespace-nowrap ${currentTab === 'all' ? 'font-bold text-blue-600 border-b-2 border-blue-600' : 'font-semibold text-gray-500 hover:text-gray-800'}` href=`/admin/feedbacks?tab=all&q=${encodeURIComponent(safeQuery)}`) Tất cả (#{allCount})

    div(class='overflow-x-auto')
      table(class='table w-full')
        thead(class='bg-white text-xs font-extrabold text-gray-400 tracking-wider border-b border-gray-100')
          tr
            th(class='w-12 pl-6')
              input(class='checkbox checkbox-sm border-gray-300' type='checkbox')
            th KHÁCH HÀNG
            th SẢN PHẨM
            th(class='w-1/3') NỘI DUNG ĐÁNH GIÁ
            th CẢNH BÁO
            th TRẠNG THÁI
            th(class='text-center') TÁC VỤ

        tbody(class='text-sm align-top')
          if feedbacks && feedbacks.length
            each feedback in feedbacks
              - const userName = (feedback.user && feedback.user.name) ? feedback.user.name : ((feedback.user && feedback.user.username) ? feedback.user.username : 'Ẩn danh')
              - const avatar = (feedback.user && feedback.user.avatar) ? feedback.user.avatar : `https://api.dicebear.com/7.x/notionists/svg?seed=${encodeURIComponent(userName)}`
              - const productName = 'Đồng hồ Rolex'
              - const warningLabel = feedback.rating >= 4 ? 'Tích cực' : (feedback.rating <= 2 ? 'Tiêu cực / Rủi ro' : 'Bình thường')
              - const warningClass = feedback.rating >= 4 ? 'bg-green-50 text-green-600' : (feedback.rating <= 2 ? 'bg-red-50 text-red-500' : 'bg-blue-50 text-blue-600')
              - const statusLabel = feedback.status === 'APPROVED' ? 'Đã duyệt' : (feedback.status === 'REJECTED' ? 'Đã từ chối' : 'Chờ duyệt')
              - const statusClass = feedback.status === 'APPROVED' ? 'bg-green-50 text-green-600' : (feedback.status === 'REJECTED' ? 'bg-red-50 text-red-500' : 'bg-orange-50 text-orange-500')

              tr(class='border-b border-gray-50 hover:bg-gray-50')
                td(class='pl-6')
                  input(class='checkbox checkbox-sm border-gray-300' type='checkbox')
                td
                  div(class='flex items-center gap-3')
                    img(class='w-10 h-10 rounded-full object-cover bg-gray-100' src=avatar alt='User')
                    div
                      div(class='font-bold text-gray-900')= userName
                      div(class='text-xs text-gray-400') ID: #{feedback.userId}
                td
                  p(class='font-semibold text-gray-700 max-w-[220px] truncate')= productName
                td
                  div(class='flex text-yellow-400 mb-1')
                    - for (let i = 1; i <= 5; i++) {
                      svg(xmlns='http://www.w3.org/2000/svg' class=`h-3 w-3 ${i <= feedback.rating ? 'text-yellow-400' : 'text-gray-200'}` viewBox='0 0 20 20' fill='currentColor')
                        path(d='M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z')
                    - }
                  p(class='text-gray-600 mb-2 line-clamp-2')= feedback.content
                  if feedback.ReviewMedia && feedback.ReviewMedia.length
                    div(class='flex gap-2')
                      each media in feedback.ReviewMedia
                        a(href=media.url target='_blank' title='Nhấn để xem ảnh lớn' class='hover:opacity-80 transition-opacity')
                          img(class='w-8 h-8 rounded-md object-cover border border-gray-200 shadow-sm' src=media.url alt='Review media' title=media.type)
                td
                  span(class=`inline-flex items-center gap-1 px-3 py-1 rounded-md text-xs font-bold ${warningClass}`)= warningLabel
                td
                  span(class=`inline-block px-3 py-1 rounded-md text-xs font-bold ${statusClass}`)= statusLabel
                td(class='text-center')
                  div(class='flex items-center justify-center gap-2')
                    button(class='btn btn-circle btn-xs btn-ghost text-green-600 hover:bg-green-50' type='button' title='Duyệt')
                      | ✓
                    button(class='btn btn-circle btn-xs btn-ghost text-red-500 hover:bg-red-50' type='button' title='Từ chối/Ẩn')
                      | ✕
                    button(class='btn btn-circle btn-xs btn-ghost text-gray-400 hover:bg-gray-100' type='button')
                      | ...
          else
            tr
              td(class='text-center text-gray-500 py-10' colspan='7') Không có đánh giá phù hợp với bộ lọc hiện tại.

    if feedbacks && feedbacks.length
      //- 4. PHÂN TRANG
      - const startItem = (pagination && pagination.startItem) ? pagination.startItem : 0
      - const endItem = (pagination && pagination.endItem) ? pagination.endItem : 0
      - const showEdgeButtons = totalPages > 2
      div(class='p-6 border-t border-gray-100 flex justify-between items-center')
        span(class='text-xs font-medium text-gray-500') Hiển thị #{startItem} - #{endItem} trong #{(pagination && pagination.total) ? pagination.total : 0} đánh giá
        div(class='join')
          if showEdgeButtons
            a(
              class=`join-item btn btn-sm border-gray-200 ${currentPage <= 1 ? 'pointer-events-none cursor-not-allowed text-gray-300' : 'text-gray-600 hover:opacity-90'}`
              style='background-color:#F1F5F9;'
              href=`/admin/feedbacks?tab=${currentTab}&q=${encodeURIComponent(safeQuery)}&page=${Math.max(1, currentPage - 1)}`
            ) <
          
          each p in ((pagination && pagination.pages) ? pagination.pages : [1])
            a(
              class=`join-item btn btn-sm ${p === currentPage ? 'pointer-events-none cursor-default text-white' : 'bg-white border-gray-200 text-gray-700 hover:bg-gray-50'}`
              style=p === currentPage ? 'background-color:#3067DF;border-color:#3067DF;' : ''
              href=p === currentPage ? 'javascript:void(0)' : `/admin/feedbacks?tab=${currentTab}&q=${encodeURIComponent(safeQuery)}&page=${p}`
            )= p
          
          if showEdgeButtons
            a(
              class=`join-item btn btn-sm border-gray-200 ${currentPage >= totalPages ? 'pointer-events-none cursor-not-allowed text-gray-300' : 'text-gray-600 hover:opacity-90'}`
              style='background-color:#F1F5F9;'
              href=`/admin/feedbacks?tab=${currentTab}&q=${encodeURIComponent(safeQuery)}&page=${Math.min(totalPages, currentPage + 1)}`
            ) >
