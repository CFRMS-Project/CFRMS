extends ../../layouts/default.pug

include ../../mixins/icons

block styles
  link(rel="stylesheet", href="/admin/css/feedbacks.css")

block content
  //- 1. HEADER (Tiêu đề và nút bấm)
  div.flex.justify-between.items-end.mb-8
    div
      h2.text-3xl.font-bold.text-gray-900 Dashboard Tổng quan
      p.text-gray-500.mt-1.text-sm Theo dõi chỉ số đánh giá và cảm xúc khách hàng thời gian thực.
    div.flex.gap-3
      //- Nút Hôm nay
      button.btn.btn-sm.h-10.px-4.border.border-none.rounded-xl.font-medium(style="background-color: #fff; color: #000;" class="hover:bg-gray-50")
        span.mr-1
          +iconCalendar()
        | Hôm nay
      //- Nút Xuất báo cáo
      button.btn.btn-sm.h-10.px-4.border-none.rounded-5xl.font-medium(style="background-color: #3067DF; color: #fff;" class="hover:opacity-90")
        span.mr-1
          +iconDownload()
        | Xuất báo cáo

  //- 2. ROW 1: BA THẺ THỐNG KÊ (METRICS CARDS)
  div.grid.grid-cols-1.gap-6.mb-6(class="md:grid-cols-3")

    //- Thẻ 1: Đánh giá mới
    div.bg-white.p-6.rounded-3xl.border.border-gray-100.shadow-sm
      div.flex.justify-between.items-start.mb-4
        div.w-12.h-12.rounded-full.bg-blue-50.flex.items-center.justify-center.text-blue-600
          +iconChat()
        div.text-right
          span.inline-block.px-2.py-1.bg-green-50.text-green-600.text-xs.font-bold.rounded-md +12%
          p.text-10.text-gray-400.mt-1.font-medium vs tháng trước
      p.text-xs.font-bold.text-gray-500.tracking-wider.mb-1 ĐÁNH GIÁ MỚI
      h3.text-4xl.font-extrabold.text-gray-900 1,284

    //- Thẻ 2: Điểm trung bình
    div.bg-white.p-6.rounded-3xl.border.border-gray-100.shadow-sm
      div.flex.justify-between.items-start.mb-4
        div.w-12.h-12.rounded-full.bg-orange-50.flex.items-center.justify-center.text-yellow-500
          +iconStar()
        div.text-right
          span.inline-block.px-2.py-1.bg-green-50.text-green-600.text-xs.font-bold.rounded-md +0.1
          p.text-10.text-gray-400.mt-1.font-medium Cải thiện
      p.text-xs.font-bold.text-gray-500.tracking-wider.mb-1 ĐIỂM TRUNG BÌNH
      div.flex.items-baseline.gap-1
        h3.text-4xl.font-extrabold.text-gray-900 4.9
        span.text-sm.font-bold.text-gray-400 /5.0

    //- Thẻ 3: Tỷ lệ phản hồi
    div.bg-white.p-6.rounded-3xl.border.border-gray-100.shadow-sm
      div.flex.justify-between.items-start.mb-4
        div.w-12.h-12.rounded-full.bg-blue-50.flex.items-center.justify-center.text-blue-600
          +iconDocument()
        div.text-right
          span.inline-block.px-2.py-1.bg-red-50.text-red-500.text-xs.font-bold.rounded-md -2%
          p.text-10.text-gray-400.mt-1.font-medium Cần chú ý
      p.text-xs.font-bold.text-gray-500.tracking-wider.mb-1 TỶ LỆ PHẢN HỒI
      div.flex.items-center.gap-4
        h3.text-4xl.font-extrabold.text-gray-900 95%
        progress.progress.progress-primary.w-full.bg-blue-50(value="95" max="100")

  //- 3. ROW 2: BIỂU ĐỒ & DANH SÁCH (CHIA LƯỚI 1/3 VÀ 2/3)
  div.grid.grid-cols-1.gap-6(class="lg:grid-cols-3")

    //- Cột Trái: Phân tích cảm xúc
    div.bg-white.p-8.rounded-3xl.border.border-gray-100.shadow-sm.flex.flex-col
      div.flex.justify-between.items-center.mb-8
        h3.font-bold.text-gray-900.text-lg Phân tích cảm xúc
        button.text-gray-400(class="hover:text-gray-600")
          +iconDots()

      //- Vòng tròn % dùng daisyUI
      div.flex.justify-center.mb-10
        div.radial-progress.text-yellow-400(style="--value:78; --size:14rem; --thickness: 1.5rem;" role="progressbar")
          div.flex.flex-col.items-center.justify-center.text-gray-900.mt-2
            span.text-4xl.font-extrabold 78%
            span.text-xs.font-bold.text-gray-400.tracking-widest.mt-1 TÍCH CỰC

      //- Chú giải (Legend)
      div.space-y-4.mb-10
        div.flex.justify-between.items-center
          div.flex.items-center.gap-3
            div.w-2.h-2.rounded-full.bg-green-500
            span.text-sm.font-semibold.text-gray-600 Tích cực
          span.font-bold.text-gray-900 78%
        div.flex.justify-between.items-center
          div.flex.items-center.gap-3
            div.w-2.h-2.rounded-full.bg-yellow-400
            span.text-sm.font-semibold.text-gray-600 Trung lập
          span.font-bold.text-gray-900 15%
        div.flex.justify-between.items-center
          div.flex.items-center.gap-3
            div.w-2.h-2.rounded-full.bg-red-500
            span.text-sm.font-semibold.text-gray-600 Tiêu cực
          span.font-bold.text-gray-900 7%

      //- Kết luận chung
      div.mt-auto.text-center.pt-6.border-t.border-gray-100
        p.text-xs.font-semibold.text-gray-400.mb-1 Đánh giá chung
        p.text-2xl.font-extrabold.text-blue-600.tracking-wide TUYỆT VỜI

    //- Cột Phải: 2 Danh sách sản phẩm (Chiếm 2/3)
    div.flex.flex-col.gap-6(class="lg:col-span-2")

      //- Danh sách 1: Sản phẩm được yêu thích
      div.bg-white.p-8.rounded-3xl.border.border-gray-100.shadow-sm
        div.flex.justify-between.items-center.mb-6
          div.flex.items-center.gap-2
            div.w-6.h-6.rounded-full.bg-green-100.flex.items-center.justify-center.text-green-600
              +iconStar("h-3 w-3")
            h3.font-bold.text-gray-900.text-lg Sản phẩm được yêu thích
          a.text-sm.text-blue-600.font-semibold(href="#", class="hover:underline") Xem tất cả

        //- Tiêu đề bảng
        div.grid.grid-cols-12.text-xs.font-bold.text-gray-400.tracking-wider.mb-4
          div.col-span-6 SẢN PHẨM
          div.col-span-3.text-center XẾP HẠNG
          div.col-span-3.text-right ĐÁNH GIÁ

        //- Dòng dữ liệu 1
        div.grid.grid-cols-12.items-center.py-4.border-b.border-gray-50
          div.col-span-6.flex.items-center.gap-4
            img.w-12.h-12.rounded-full.object-cover.bg-gray-100(src="https://api.dicebear.com/7.x/notionists/svg?seed=chanel1" alt="Product")
            span.font-bold.text-gray-900.text-sm Chanel No.5 Parfum
          div.col-span-3.flex.justify-center
            span.inline-flex.items-center.gap-1.px-3.py-1.bg-green-50.text-green-600.rounded-lg.text-xs.font-bold
              | 5.0
              +iconStar("h-3 w-3")
          div.col-span-3.text-right.font-extrabold.text-gray-900 342

        //- Dòng dữ liệu 2
        div.grid.grid-cols-12.items-center.py-4
          div.col-span-6.flex.items-center.gap-4
            img.w-12.h-12.rounded-full.object-cover.bg-gray-100(src="https://api.dicebear.com/7.x/notionists/svg?seed=chanel2" alt="Product")
            span.font-bold.text-gray-900.text-sm Chanel No.5 Parfum
          div.col-span-3.flex.justify-center
            span.inline-flex.items-center.gap-1.px-3.py-1.bg-green-50.text-green-600.rounded-lg.text-xs.font-bold
              | 4.9
              +iconStar("h-3 w-3")
          div.col-span-3.text-right.font-extrabold.text-gray-900 218

      //- Danh sách 2: Sản phẩm cần cải thiện
      div.bg-white.p-8.rounded-3xl.border.border-gray-100.shadow-sm
        div.flex.justify-between.items-center.mb-6
          div.flex.items-center.gap-2
            div.w-6.h-6.rounded-full.bg-red-100.flex.items-center.justify-center.text-red-500
              +iconWarning()
            h3.font-bold.text-gray-900.text-lg Sản phẩm cần cải thiện
          a.text-sm.text-blue-600.font-semibold(href="#", class="hover:underline") Xử lý ngay

        //- Tiêu đề bảng
        div.grid.grid-cols-12.text-xs.font-bold.text-gray-400.tracking-wider.mb-4
          div.col-span-6 SẢN PHẨM
          div.col-span-3.text-center XẾP HẠNG
          div.col-span-3.text-right VẤN ĐỀ

        //- Dòng dữ liệu 1
        div.grid.grid-cols-12.items-center.py-4.border-b.border-gray-50
          div.col-span-6.flex.items-center.gap-4
            img.w-12.h-12.rounded-full.object-cover.bg-gray-100(src="https://api.dicebear.com/7.x/notionists/svg?seed=chanel3" alt="Product")
            span.font-bold.text-gray-900.text-sm Chanel No.5 Parfum
          div.col-span-3.flex.justify-center
            span.inline-flex.items-center.gap-1.px-3.py-1.bg-red-50.text-red-500.rounded-lg.text-xs.font-bold
              | 3.2
              +iconStar("h-3 w-3")
          div.col-span-3.text-right
            span.inline-block.px-3.py-2.bg-gray-100.text-gray-600.text-10.font-bold.rounded-md.tracking-wider ĐỘ BỀN KHÓA

        //- Dòng dữ liệu 2
        div.grid.grid-cols-12.items-center.py-4
          div.col-span-6.flex.items-center.gap-4
            img.w-12.h-12.rounded-full.object-cover.bg-gray-100(src="https://api.dicebear.com/7.x/notionists/svg?seed=chanel4" alt="Product")
            span.font-bold.text-gray-900.text-sm Chanel No.5 Parfum
          div.col-span-3.flex.justify-center
            span.inline-flex.items-center.gap-1.px-3.py-1.bg-yellow-50.text-yellow-600.rounded-lg.text-xs.font-bold
              | 3.8
              +iconStar("h-3 w-3")
          div.col-span-3.text-right
            span.inline-block.px-3.py-2.bg-gray-100.text-gray-600.text-10.font-bold.rounded-md.tracking-wider GIAO HÀNG CHẬM