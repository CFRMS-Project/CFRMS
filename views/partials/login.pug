doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Đăng nhập - ShopVN
    script(src="https://cdn.tailwindcss.com")
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap", rel="stylesheet")
    style.
      body { font-family: 'Inter', sans-serif; }

  body(class="bg-slate-50 min-h-screen flex flex-col")
    include ../customer/header.pug
    
    main(class="flex-grow flex items-center justify-center p-4 md:p-8")
      .login-container(class="bg-white w-full max-w-5xl rounded-[2rem] overflow-hidden shadow-2xl flex flex-col md:flex-row min-h-[650px]")
        
        //- Cột trái: Hình ảnh & Branding
        .login-left(class="md:w-1/2 relative p-10 flex flex-col justify-between text-white overflow-hidden bg-slate-900")
          //- Background Image với Overlay
          img(src="https://res.cloudinary.com/dsaq5kgkg/image/upload/c_fill,g_auto,w_800,h_1200,q_auto,f_auto/v1774016858/dong-ho-Seiko-Prospex-PDM-SRPM03K1-Limited-Edition-5_i4tbtp.png" class="absolute inset-0 w-full h-full object-cover opacity-40")
          .overlay(class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/20 to-transparent")
          
          .brand(class="relative z-10 flex items-center gap-3")
            .brand-icon(class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center shadow-lg shadow-blue-500/30")
              svg(class="w-6 h-6 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                path(d="M6 3h12l4 6-10 12L2 9l4-6z")
                path(d="M2 9h20")
                path(d="M12 21V9")
            span(class="text-xl font-bold tracking-widest") SHOPVN
          
          .hero-text(class="relative z-10")
            p(class="text-blue-400 text-xs font-bold tracking-[0.2em] mb-4 uppercase") New Collection 2024
            h1(class="text-4xl md:text-5xl font-bold leading-tight mb-6") Định hình phong cách#[br]riêng của bạn.
            p(class="text-slate-300 text-sm leading-relaxed max-w-md") Khám phá những bộ sưu tập phụ kiện và thời trang cao cấp được tuyển chọn kỹ lưỡng dành riêng cho bạn.

        //- Cột phải: Form Đăng nhập
        .login-right(class="md:w-1/2 p-8 md:p-16 flex flex-col justify-center bg-white relative")
          .form-wrapper(class="w-full max-w-sm mx-auto")
            .header(class="mb-10 text-left")
              h2(class="text-3xl font-bold text-slate-800 mb-3") Chào mừng trở lại
              p(class="text-slate-500 text-sm") Đăng nhập để tiếp tục trải nghiệm mua sắm đẳng cấp.

            form(action="/login" method="POST" class="space-y-6")
              //- Thông báo lỗi
              if errorMessage
                div(class="bg-red-50 border border-red-200 text-red-600 text-sm px-4 py-3 rounded-xl flex items-center gap-2")
                  span ⚠️
                  span= errorMessage

              //- Nhập Username
              .input-group
                label(for="username" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2") Email hoặc Tên đăng nhập
                .input-wrapper(class="relative")
                  span.icon-left(class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400")
                    svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                      circle(cx="12" cy="12" r="4")
                      path(d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8")
                  input#username(type="text" name="username" placeholder="name@company.com" class="w-full pl-12 pr-4 py-3.5 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all duration-200")

              //- Nhập Mật khẩu
              .input-group
                .label-row(class="flex justify-between items-center mb-2")
                  label(for="password" class="text-xs font-bold text-slate-700 uppercase tracking-wider") Mật khẩu
                  a.forgot-pw(href="#" class="text-xs font-semibold text-blue-600 hover:text-blue-700") Quên mật khẩu?
                .input-wrapper(class="relative")
                  span.icon-left(class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400")
                    svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                      rect(x="3" y="11" width="18" height="11" rx="2" ry="2")
                      path(d="M7 11V7a5 5 0 0 1 10 0v4")
                  input#password(type="password" name="password" placeholder="••••••••" class="w-full pl-12 pr-12 py-3.5 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all duration-200")
                  button.btn-icon(type="button" class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600")
                    svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                      path(d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z")
                      circle(cx="12" cy="12" r="3")

              //- Ghi nhớ
              .checkbox-group(class="flex items-center gap-2")
                input#remember(type="checkbox" class="w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500")
                label(for="remember" class="text-sm text-slate-600 cursor-pointer") Ghi nhớ đăng nhập

              //- Nút Submit
              button.btn-submit(type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-4 rounded-xl font-bold text-sm shadow-lg shadow-blue-500/25 flex items-center justify-center gap-2 transition-all active:scale-[0.98]")
                span Đăng nhập
                svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                  line(x1="5" y1="12" x2="19" y2="12")
                  polyline(points="12 5 19 12 12 19")

            p.register-prompt(class="mt-10 text-center text-sm text-slate-500") Chưa có tài khoản? #[a(href="#" class="text-blue-600 font-bold hover:underline ml-1") Đăng ký ngay]
              
          //- Footer Links
          .footer-links(class="absolute bottom-8 left-0 right-0 flex justify-center gap-6 text-[10px] font-bold text-slate-400 uppercase tracking-widest")
            a(href="#" class="hover:text-slate-600") Điều khoản
            a(href="#" class="hover:text-slate-600") Bảo mật
            a(href="#" class="hover:text-slate-600") Hỗ trợ

    include ../customer/footer.pug