header(class="bg-white border-b sticky top-0 z-50")
  div(class="max-w-7xl mx-auto px-4 h-20 flex items-center justify-between")
    // Logo
    div(class="flex items-center space-x-2")
      div(class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center text-white text-xs") 💎
      span(class="font-black text-xl text-blue-900 tracking-tighter") SHOPVN

    // Navigation
    nav(class="hidden md:flex items-center space-x-8 text-sm font-medium text-gray-600")
      a(href="/" class="hover:text-blue-600 transition") Trang chủ
      a(href="/san-pham" class="hover:text-blue-600 transition") Sản phẩm
      a(href="/lich-su" class="hover:text-blue-600 transition font-bold text-blue-600") Đơn hàng

    // User actions
    div(class="flex items-center space-x-5")
      button(class="w-10 h-10 bg-gray-50 rounded-full flex items-center justify-center text-gray-400") 🔔
      button(class="w-10 h-10 bg-gray-50 rounded-full flex items-center justify-center text-gray-400") 👜
      div(class="w-10 h-10 rounded-full border-2 border-green-500 overflow-hidden")
        img(src="/images/avatar.jpg" alt="User" class="w-full h-full object-cover")
      button(class="bg-blue-600 text-white px-5 py-2 rounded-full text-sm font-bold shadow-md shadow-blue-200 hover:bg-blue-700 transition") Đăng xuất
