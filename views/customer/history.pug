extends ../layouts/customer.pug

block head
  style.
    /* ══ Shared Modal Styles ══ */
    .fb-modal-overlay {
      position: fixed; inset: 0; z-index: 9999;
      background: rgba(0,0,0,.55);
      backdrop-filter: blur(6px);
      display: flex; align-items: center; justify-content: center;
      padding: 1rem;
      opacity: 0; pointer-events: none;
      transition: opacity .25s;
    }
    .fb-modal-overlay.open { opacity: 1; pointer-events: auto; }
    .fb-modal {
      background: #fff;
      border-radius: 1.5rem;
      width: 100%; max-width: 600px;
      max-height: 92vh; overflow-y: auto;
      box-shadow: 0 32px 80px -10px rgba(0,0,0,.3);
      transform: translateY(20px) scale(.97);
      transition: transform .3s cubic-bezier(.22,1,.36,1), opacity .25s;
      opacity: 0;
      scrollbar-width: thin;
    }
    .fb-modal-overlay.open .fb-modal { transform: translateY(0) scale(1); opacity: 1; }
    .fb-modal-header {
      background: linear-gradient(135deg, #2563eb, #4f46e5);
      padding: 1.25rem 1.75rem;
      display: flex; align-items: center; justify-content: space-between;
      border-radius: 1.5rem 1.5rem 0 0;
      position: sticky; top: 0; z-index: 10;
    }
    .fb-modal-title {
      color: #fff; font-size: .95rem; font-weight: 700;
      letter-spacing: -.01em; display: flex; align-items: center; gap: .6rem;
    }
    .fb-modal-title svg { width: 17px; height: 17px; }
    .fb-modal-close {
      background: rgba(255,255,255,.15); border: none; border-radius: 50%;
      width: 30px; height: 30px; cursor: pointer; color: #fff;
      display: flex; align-items: center; justify-content: center;
      transition: background .2s;
    }
    .fb-modal-close:hover { background: rgba(255,255,255,.3); }
    .fb-modal-body { padding: 1.5rem 1.75rem; }
    .fb-section { margin-bottom: 1.4rem; }
    .fb-label {
      font-size: .72rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: .1em; color: #64748b; margin-bottom: .55rem; display: block;
    }
    /* Stars */
    .star-row { display: flex; justify-content: center; gap: .4rem; margin-bottom: .4rem; }
    .modal-star-btn { background: none; border: none; cursor: pointer; padding: .2rem; transition: transform .15s; outline: none; }
    .modal-star-btn:hover { transform: scale(1.15); }
    .modal-star-btn svg { width: 36px; height: 36px; display: block; }
    .star-rating-label { text-align: center; height: 1.2rem; font-size: .82rem; font-weight: 700; }
    /* Tags */
    .tag-grid { display: flex; flex-wrap: wrap; gap: .45rem; }
    .modal-tag-btn {
      padding: .35rem .85rem; border-radius: 9999px; font-size: .78rem; font-weight: 700;
      border: 2px solid #e2e8f0; cursor: pointer; background: #fff; color: #475569;
      transition: all .18s;
    }
    .modal-tag-btn.selected { background: #2563eb; border-color: #2563eb; color: #fff; }
    /* Read-only tags */
    .fb-tag-chip {
      display: inline-flex; padding: .3rem .8rem; border-radius: 9999px;
      background: #eff6ff; color: #1d4ed8; font-size: .75rem; font-weight: 700;
      border: 1px solid #bfdbfe;
    }
    /* Textarea */
    .fb-textarea {
      width: 100%; border: 2px solid #e2e8f0; border-radius: .875rem;
      padding: .8rem 1rem; font-size: .875rem; color: #334155;
      font-family: inherit; resize: none; outline: none; transition: border-color .2s;
    }
    .fb-textarea:focus { border-color: #3b82f6; }
    /* Image upload */
    .upload-label {
      display: inline-flex; align-items: center; gap: .5rem;
      padding: .5rem 1rem; border: 2px dashed #cbd5e1;
      border-radius: .875rem; font-size: .78rem; font-weight: 700;
      color: #64748b; cursor: pointer; transition: all .18s; background: #f8fafc;
    }
    .upload-label:hover { border-color: #3b82f6; color: #2563eb; background: #eff6ff; }
    .img-preview-wrap { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: .6rem; }
    /* Anon toggle */
    .anon-row {
      display: flex; align-items: center; gap: .75rem;
      background: #f8fafc; border: 1px solid #e2e8f0;
      border-radius: .875rem; padding: .8rem 1rem;
    }
    .anon-row label { font-size: .875rem; color: #475569; cursor: pointer; }
    /* Footer */
    .fb-modal-footer {
      display: flex; justify-content: flex-end; gap: .75rem;
      padding: 0 1.75rem 1.5rem;
    }
    .btn-cancel {
      padding: .65rem 1.3rem; border-radius: 9999px;
      border: 2px solid #e2e8f0; background: #fff;
      color: #475569; font-weight: 700; font-size: .82rem; cursor: pointer; transition: all .18s;
    }
    .btn-cancel:hover { background: #f8fafc; }
    .btn-submit-modal {
      padding: .65rem 1.4rem; border-radius: 9999px; border: none;
      background: linear-gradient(135deg, #2563eb, #4f46e5);
      color: #fff; font-weight: 700; font-size: .82rem; cursor: pointer;
      display: flex; align-items: center; gap: .45rem;
      box-shadow: 0 6px 20px -4px rgba(37,99,235,.4); transition: all .18s;
    }
    .btn-submit-modal:hover { filter: brightness(1.08); transform: translateY(-1px); }
    .btn-submit-modal:active { transform: scale(.97); }
    /* View modal info rows */
    .view-meta-row { display: flex; align-items: center; gap: .75rem; margin-bottom: 1.25rem; padding-bottom: 1rem; border-bottom: 1px solid #f1f5f9; }
    .view-avatar { width: 44px; height: 44px; border-radius: 50%; background: #dbeafe; color: #2563eb; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1rem; text-transform: uppercase; flex-shrink: 0; }
    .view-rating-stars { display: flex; gap: 3px; }
    .view-rating-stars svg { width: 22px; height: 22px; }
    .view-content-box { background: #f8fafc; border-radius: 1rem; padding: 1rem; border: 1px solid #f1f5f9; font-size: .875rem; color: #475569; line-height: 1.7; }
    .view-images { display: flex; flex-wrap: wrap; gap: .6rem; }
    .view-img-thumb { width: 88px; height: 88px; border-radius: .875rem; object-fit: cover; border: 2px solid #e2e8f0; cursor: pointer; transition: opacity .2s; }
    .view-img-thumb:hover { opacity: .8; }
    /* Edit to view switch link inside modal */
    .modal-switch-link {
      display: inline-flex; align-items: center; gap: .35rem;
      font-size: .78rem; font-weight: 700; color: rgba(255,255,255,.8);
      text-decoration: none; transition: color .2s;
    }
    .modal-switch-link:hover { color: #fff; }

block content
  main.history-wrapper(class="max-w-4xl mx-auto my-10 px-4 min-h-[60vh]")
    .history-container

      //- Thống kê người dùng
      .user-stats-card(class="bg-white rounded-2xl p-6 md:p-8 flex flex-col md:flex-row justify-between items-center mb-8 shadow-sm border border-slate-100")
        .user-info(class="flex items-center gap-5 mb-6 md:mb-0")
          if currentUser && currentUser.avatar
            img.user-avatar-large(src=currentUser.avatar alt=currentUser.name class="w-16 h-16 rounded-full object-cover ring-4 ring-blue-50")
          else
            div.user-avatar-large(class="w-16 h-16 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center text-2xl font-bold ring-4 ring-blue-50 uppercase") #{currentUser ? currentUser.name.charAt(0) : 'U'}
          h2.user-name(class="text-xl font-bold text-slate-800") #{currentUser ? currentUser.name : 'Khách hàng'}
        
        .user-metrics(class="flex items-center gap-8 md:gap-12")
          .metric(class="flex flex-col items-center gap-1")
            span.metric-label(class="text-[10px] font-bold text-slate-400 uppercase tracking-widest") Đơn hàng
            span.metric-value(class="text-xl font-bold text-slate-800") #{feedbacks ? feedbacks.length + 1 : 1}
          .metric-divider(class="w-px h-10 bg-slate-100")
          .metric(class="flex flex-col items-center gap-1")
            span.metric-label(class="text-[10px] font-bold text-slate-400 uppercase tracking-widest") Tích lũy
            span.metric-value(class="text-xl font-bold text-blue-600") 2.4Mđ

      //- Tabs
      .order-tabs(class="flex gap-8 border-b border-slate-200 mb-8 overflow-x-auto whitespace-nowrap")
        a.tab(href="#" class="pb-4 text-sm font-bold text-blue-600 border-b-2 border-blue-600") Tất cả
        a.tab(href="#" class="pb-4 text-sm font-medium text-slate-500 hover:text-blue-600 transition-colors") Đang giao
        a.tab(href="#" class="pb-4 text-sm font-medium text-slate-500 hover:text-blue-600 transition-colors") Đã nhận
        a.tab(href="#" class="pb-4 text-sm font-medium text-slate-500 hover:text-blue-600 transition-colors") Đã hủy

      //- Danh sách đơn hàng
      .order-list(class="flex flex-col gap-6")

        //- === Đơn hàng chưa đánh giá (tĩnh) ===
        .order-card(class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 hover:shadow-md transition-shadow")
          .order-header(class="flex flex-col md:flex-row justify-between items-start md:items-center pb-5 border-b border-slate-50 mb-5 gap-4")
            .order-info-left(class="space-y-1")
              span.order-id(class="text-[10px] font-bold text-slate-400 uppercase tracking-wider") Mã đơn: #SVN-8329 | Mới nhất
              div.order-status(class="flex items-center gap-2 text-emerald-600 font-bold text-xs")
                span.dot(class="w-2 h-2 rounded-full bg-emerald-500")
                | Đã nhận
            .order-info-right(class="md:text-right")
              span.total-label(class="block text-[10px] text-slate-400 uppercase font-bold") Tổng thanh toán
              span.total-price(class="text-lg font-bold text-blue-600") 18.500.000đ
          
          .order-body(class="mb-6")
            .product-item(class="flex gap-4 items-center")
              img(src="https://res.cloudinary.com/dsaq5kgkg/image/upload/c_thumb,g_auto,w_200,h_200,q_auto,f_auto/v1774021075/Seiko-Prospex-PDM2_nvcjp5.png" alt="Đồng hồ" class="w-20 h-20 rounded-xl object-cover bg-slate-900 border border-slate-100")
              .product-details(class="flex-1")
                h3(class="text-sm font-bold text-slate-800") Seiko Prospex Speedtimer Solar Chronograph
                p(class="text-xs text-slate-500 mt-1") Phân loại: Đồng hồ cao cấp Seiko
                div(class="flex gap-4 mt-2")
                  span(class="text-xs font-bold text-blue-600") 18.500.000đ
                  span(class="text-xs text-slate-400") Số lượng: x1
          
          .order-footer(class="flex flex-col sm:flex-row justify-end gap-3 pt-5 border-t border-slate-50")
            button(class="px-6 py-2.5 rounded-full bg-slate-100 text-slate-700 text-xs font-bold hover:bg-slate-200 transition-all") Mua lại
            button.js-open-create(
              type="button"
              class="px-6 py-2.5 rounded-full bg-blue-600 text-white text-xs font-bold hover:bg-blue-700 transition-all flex items-center gap-2 shadow-lg shadow-blue-500/20"
            )
              svg(xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                path(d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z")
              | Viết đánh giá

        //- === Feedbacks từ DB ===
        if feedbacks && feedbacks.length > 0
          each fb in feedbacks
            - var fd = new Date(fb.createdAt)
            - var fdStr = fd.getDate().toString().padStart(2,'0') + '/' + (fd.getMonth()+1).toString().padStart(2,'0') + '/' + fd.getFullYear()
            - var fbTags = fb.tags ? fb.tags.split(',').map(function(t){ return t.trim(); }) : []
            - var fbImages = fb.reviewMedia ? fb.reviewMedia.map(function(m){ return m.url; }) : []

            .order-card(class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100")
              .order-header(class="flex flex-col md:flex-row justify-between items-start md:items-center pb-5 border-b border-slate-50 mb-5 gap-4")
                .order-info-left(class="space-y-1")
                  span.order-id(class="text-[10px] font-bold text-slate-400 uppercase tracking-wider") Đánh giá ID: ##{fb.id} | #{fdStr}
                  div.order-status(class="flex items-center gap-2 text-emerald-600 font-bold text-xs")
                    span.dot(class="w-2 h-2 rounded-full bg-emerald-500")
                    | Đã đánh giá
                .order-info-right(class="md:text-right")
                  span.total-label(class="block text-[10px] text-slate-400 uppercase font-bold") Trạng thái
                  if fb.status === 'APPROVED'
                    span(class="text-sm font-bold text-green-600") Đã duyệt
                  else if fb.status === 'PENDING'
                    span(class="text-sm font-bold text-amber-500") Chờ duyệt
                  else
                    span(class="text-sm font-bold text-red-600") Từ chối

              .order-body(class="mb-6")
                .product-item(class="flex gap-4 items-center")
                  img(src="https://res.cloudinary.com/dsaq5kgkg/image/upload/c_thumb,g_auto,w_200,h_200,q_auto,f_auto/v1774021075/Seiko-Prospex-PDM2_nvcjp5.png" alt="Đồng hồ" class="w-20 h-20 rounded-xl object-cover bg-slate-900 border border-slate-100")
                  .product-details(class="flex-1")
                    h3(class="text-sm font-bold text-slate-800") Seiko Prospex Speedtimer Solar Chronograph
                    p(class="text-xs text-slate-500 mt-1")
                      if fb.isAnonymous
                        span Ẩn danh
                      else
                        span #{currentUser ? currentUser.name : ''}
                    .product-rating(class="flex gap-0.5 mt-2")
                      - for (var x = 1; x <= 5; x++)
                        if x <= fb.rating
                          svg(xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="#FBBF24" stroke="#FBBF24")
                            polygon(points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2")
                        else
                          svg(xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#CBD5E1" stroke-width="2")
                            polygon(points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2")
                    p(class="text-xs text-slate-500 mt-1.5 italic line-clamp-2") "#{fb.content}"

              .order-footer(class="flex flex-col sm:flex-row justify-end gap-3 pt-5 border-t border-slate-50")
                //- Nút Xem → mở View Modal
                button.js-open-view(
                  type="button"
                  data-id=fb.id
                  data-rating=fb.rating
                  data-content=fb.content
                  data-tags=fb.tags
                  data-images=JSON.stringify(fbImages)
                  data-anon=fb.isAnonymous
                  data-user=(fb.isAnonymous ? 'Ẩn danh' : (currentUser ? currentUser.name : ''))
                  data-date=fdStr
                  class="px-6 py-2.5 rounded-full border border-slate-200 text-slate-600 text-xs font-bold hover:bg-slate-50 transition-all flex items-center gap-2"
                )
                  | Xem

                //- Nút Sửa → mở Edit Modal
                button.js-open-edit(
                  type="button"
                  data-id=fb.id
                  data-rating=fb.rating
                  data-content=fb.content
                  data-tags=fb.tags
                  data-images=JSON.stringify(fbImages)
                  data-anon=fb.isAnonymous
                  class="px-6 py-2.5 rounded-full bg-slate-100 text-blue-600 text-xs font-bold hover:bg-slate-200 transition-all flex items-center gap-2"
                )
                  | Sửa

                //- Nút Xóa
                form(action=`/feedback/${fb.id}/toggle-hide` method="POST" class="inline")
                  button(type="submit" onclick="return confirm('Bạn có chắc chắn muốn ẩn đánh giá này không?')" class="px-6 py-2.5 rounded-full bg-red-50 text-red-600 text-xs font-bold hover:bg-red-100 transition-all")
                    | Xóa (Ẩn)

  //- ══════════════════════════════════════════════════
  //- MODAL 1: VIẾT ĐÁNH GIÁ MỚI (Create)
  //- ══════════════════════════════════════════════════
  #createModal.fb-modal-overlay(aria-modal="true" role="dialog")
    .fb-modal
      .fb-modal-header
        .fb-modal-title
          svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
            path(d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z")
          span Viết đánh giá
        button.fb-modal-close(type="button" data-close="createModal")
          svg(xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
            line(x1="18" y1="6" x2="6" y2="18")
            line(x1="6" y1="6" x2="18" y2="18")

      form#createForm(action="/feedback" method="POST" enctype="multipart/form-data")
        input(type="hidden" name="productId" value="1")
        input#createRating(type="hidden" name="rating" value="0")
        input#createTags(type="hidden" name="tags" value="")

        .fb-modal-body
          .fb-section(style="text-align:center")
            span.fb-label Bạn thấy sản phẩm này thế nào?
            .star-row#createStarRow
              each val in [1,2,3,4,5]
                button.modal-star-btn(type="button" data-value=val data-target="createRating")
                  svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#e2e8f0")
                    path(d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z")
            p#createStarLabel.star-rating-label(style="color:#94a3b8") Nhấn để đánh giá

          .fb-section
            span.fb-label Nhận xét nhanh
            .tag-grid#createTagGrid
              each tag in ['Đúng mô tả', 'Giao hàng nhanh', 'Đóng gói kỹ', 'Chất lượng tuyệt vời', 'Thái độ tốt', 'Vừa vặn', 'Chính sách đổi trả tốt']
                button.modal-tag-btn(type="button" data-tag=tag data-tagtarget="createTags") #{tag}

          .fb-section
            div(style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.5rem")
              span.fb-label(style="margin-bottom:0") Nội dung đánh giá
              span#createCharCount(style="font-size:.72rem;color:#94a3b8;font-weight:600") 0/500
            textarea#createContent.fb-textarea(name="content" rows="4" maxlength="500" placeholder="Chia sẻ trải nghiệm của bạn...")

          .fb-section
            span.fb-label Hình ảnh thực tế
            .img-preview-wrap#createImgPreview
            label.upload-label(for="createImgInput")
              svg(xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                path(d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z")
              | Chọn ảnh (tối đa 5)
            input#createImgInput(type="file" name="images" multiple accept="image/jpeg,image/jpg,image/png" style="display:none")
            p(style="font-size:.72rem;color:#94a3b8;margin-top:.4rem") JPG, JPEG, PNG — tối đa 10MB

          .fb-section(style="margin-bottom:0")
            .anon-row
              input#createAnon(type="checkbox" name="isAnonymous" value="on" style="width:15px;height:15px;accent-color:#2563eb;cursor:pointer")
              label(for="createAnon") Đánh giá ẩn danh

      .fb-modal-footer
        button.btn-cancel(type="button" data-close="createModal") Hủy
        button.btn-submit-modal(type="submit" form="createForm")
          svg(xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
            path(d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8")
          span Gửi đánh giá

  //- ══════════════════════════════════════════════════
  //- MODAL 2: XEM CHI TIẾT (View — readonly)
  //- ══════════════════════════════════════════════════
  #viewModal.fb-modal-overlay(aria-modal="true" role="dialog")
    .fb-modal
      .fb-modal-header
        .fb-modal-title
          svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
            path(d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z")
            circle(cx="12" cy="12" r="3")
          span Chi tiết đánh giá
        button.fb-modal-close(type="button" data-close="viewModal")
          svg(xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
            line(x1="18" y1="6" x2="6" y2="18")
            line(x1="6" y1="6" x2="18" y2="18")

      .fb-modal-body
        //- User row
        .view-meta-row
          .view-avatar#viewAvatar U
          div
            p#viewUserName(style="font-weight:700;color:#1e293b;font-size:.9rem") —
            p#viewDate(style="font-size:.75rem;color:#94a3b8;margin-top:.15rem") —

        //- Stars (readonly)
        .fb-section
          span.fb-label Đánh giá
          .view-rating-stars#viewStars
          p#viewStarText(style="font-size:.82rem;font-weight:700;color:#f59e0b;margin-top:.35rem") —/5 sao

        //- Tags
        .fb-section#viewTagsSection(style="display:none")
          span.fb-label Nhận xét nhanh
          .tag-grid#viewTags

        //- Content
        .fb-section
          span.fb-label Nội dung đánh giá
          .view-content-box#viewContent —

        //- Images
        .fb-section#viewImagesSection(style="display:none")
          span.fb-label Hình ảnh thực tế
          .view-images#viewImages

      .fb-modal-footer
        button.btn-cancel(type="button" data-close="viewModal") Đóng
        button.btn-submit-modal#viewEditSwitch(type="button" style="background:linear-gradient(135deg,#475569,#334155)")
          svg(xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
            path(d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z")
          span Chỉnh sửa

  //- ══════════════════════════════════════════════════
  //- MODAL 3: SỬA ĐÁNH GIÁ (Edit)
  //- ══════════════════════════════════════════════════
  #editModal.fb-modal-overlay(aria-modal="true" role="dialog")
    .fb-modal
      .fb-modal-header
        .fb-modal-title
          svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
            path(d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z")
          span Chỉnh sửa đánh giá
        button.fb-modal-close(type="button" data-close="editModal")
          svg(xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
            line(x1="18" y1="6" x2="6" y2="18")
            line(x1="6" y1="6" x2="18" y2="18")

      form#editForm(action="/feedback/1/update" method="POST" enctype="multipart/form-data")
        input(type="hidden" name="removedImages" id="editRemovedImages" value="[]")
        input#editRating(type="hidden" name="rating" value="0")
        input#editTags(type="hidden" name="tags" value="")

        .fb-modal-body
          .fb-section(style="text-align:center")
            span.fb-label Bạn thấy sản phẩm này thế nào?
            .star-row#editStarRow
              each val in [1,2,3,4,5]
                button.modal-star-btn(type="button" data-value=val data-target="editRating")
                  svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#e2e8f0")
                    path(d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z")
            p#editStarLabel.star-rating-label(style="color:#94a3b8") Nhấn để đánh giá

          .fb-section
            span.fb-label Nhận xét nhanh
            .tag-grid#editTagGrid
              each tag in ['Đúng mô tả', 'Giao hàng nhanh', 'Đóng gói kỹ', 'Chất lượng tuyệt vời', 'Thái độ tốt', 'Vừa vặn', 'Chính sách đổi trả tốt']
                button.modal-tag-btn(type="button" data-tag=tag data-tagtarget="editTags") #{tag}

          .fb-section
            div(style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.5rem")
              span.fb-label(style="margin-bottom:0") Nội dung đánh giá
              span#editCharCount(style="font-size:.72rem;color:#94a3b8;font-weight:600") 0/500
            textarea#editContent.fb-textarea(name="content" rows="4" maxlength="500" placeholder="Chia sẻ trải nghiệm của bạn...")

          .fb-section
            span.fb-label Hình ảnh thực tế
            .img-preview-wrap#editImgPreview
            label.upload-label(for="editImgInput")
              svg(xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                path(d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z")
              | Thêm ảnh (tối đa 5)
            input#editImgInput(type="file" name="images" multiple accept="image/jpeg,image/jpg,image/png" style="display:none")

          .fb-section(style="margin-bottom:0")
            .anon-row
              input#editAnon(type="checkbox" name="isAnonymous" value="on" style="width:15px;height:15px;accent-color:#2563eb;cursor:pointer")
              label(for="editAnon") Đánh giá ẩn danh

      .fb-modal-footer
        button.btn-cancel(type="button" data-close="editModal") Hủy
        button.btn-submit-modal(type="submit" form="editForm")
          svg(xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
            path(d="M5 13l4 4L19 7")
          span Cập nhật

block scripts
  script.
    document.addEventListener('DOMContentLoaded', function () {
      // ── Toast
      var urlParams = new URLSearchParams(window.location.search);
      var msg = urlParams.get('message');
      if (msg === 'success')              alert('Đã gửi đánh giá thành công!');
      else if (msg === 'update_success')  alert('Đã cập nhật đánh giá thành công!');
      else if (msg === 'hide_success')    alert('Đã ẩn đánh giá khỏi hệ thống!');

      // ── Modal helpers
      var overlays = {
        createModal: document.getElementById('createModal'),
        viewModal:   document.getElementById('viewModal'),
        editModal:   document.getElementById('editModal'),
      };

      function openModal(id) {
        Object.values(overlays).forEach(function(o){ if (o) o.classList.remove('open'); });
        if (overlays[id]) overlays[id].classList.add('open');
        document.body.style.overflow = 'hidden';
      }
      function closeModal(id) {
        if (overlays[id]) overlays[id].classList.remove('open');
        document.body.style.overflow = '';
      }
      function closeAll() {
        Object.keys(overlays).forEach(function(id){ closeModal(id); });
      }

      // Close buttons (data-close)
      document.querySelectorAll('[data-close]').forEach(function(btn) {
        btn.addEventListener('click', function() { closeModal(btn.dataset.close); });
      });
      // Click outside
      Object.entries(overlays).forEach(function(e) {
        e[1] && e[1].addEventListener('click', function(ev) { if (ev.target === e[1]) closeAll(); });
      });
      document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeAll(); });

      // ── Rating helpers
      var ratingLabels = ['','Rất tệ','Không hài lòng','Bình thường','Hài lòng','Tuyệt vời'];
      var ratingColors = ['','#ef4444','#f97316','#eab308','#84cc16','#f59e0b'];

      function initStars(rowId, inputId, labelId) {
        var row   = document.getElementById(rowId);
        var input = document.getElementById(inputId);
        var label = document.getElementById(labelId);
        if (!row) return;
        var btns  = row.querySelectorAll('.modal-star-btn');
        function setVal(val) {
          input.value = val;
          btns.forEach(function(b) {
            b.querySelector('svg').setAttribute('fill', Number(b.dataset.value) <= val ? '#fbbf24' : '#e2e8f0');
          });
          if (val > 0) { label.style.color = ratingColors[val]; label.textContent = ratingLabels[val]; }
          else         { label.style.color = '#94a3b8';          label.textContent = 'Nhấn để đánh giá'; }
        }
        btns.forEach(function(b) {
          b.addEventListener('click',      function() { setVal(Number(b.dataset.value)); });
          b.addEventListener('mouseenter', function() { setVal(Number(b.dataset.value)); });
        });
        row.addEventListener('mouseleave', function() { setVal(Number(input.value)); });
        return setVal;
      }

      var setCreateStars = initStars('createStarRow', 'createRating', 'createStarLabel');
      var setEditStars   = initStars('editStarRow',   'editRating',   'editStarLabel');

      // ── Tag helpers
      function initTags(gridId, inputId) {
        var grid  = document.getElementById(gridId);
        var input = document.getElementById(inputId);
        if (!grid) return;
        grid.querySelectorAll('.modal-tag-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var tag  = btn.dataset.tag;
            var tags = input.value.split(',').map(function(t){ return t.trim(); }).filter(Boolean);
            if (tags.indexOf(tag) !== -1) { tags.splice(tags.indexOf(tag), 1); btn.classList.remove('selected'); }
            else                          { tags.push(tag); btn.classList.add('selected'); }
            input.value = tags.join(', ');
          });
        });
      }
      initTags('createTagGrid', 'createTags');
      initTags('editTagGrid',   'editTags');

      // ── Char counter
      function initCharCount(textareaId, countId) {
        var ta = document.getElementById(textareaId);
        var ct = document.getElementById(countId);
        if (!ta) return;
        ta.addEventListener('input', function() { ct.textContent = ta.value.length + '/500'; });
      }
      initCharCount('createContent', 'createCharCount');
      initCharCount('editContent',   'editCharCount');

      // ── Image upload helper
      function initImgUpload(inputId, previewId, removedInputId) {
        var input   = document.getElementById(inputId);
        var preview = document.getElementById(previewId);
        var removed = removedInputId ? document.getElementById(removedInputId) : null;
        var dt      = new DataTransfer();
        var removedSet = [];

        if (!input) return;

        function addExistingImg(url) {
          var wrap = document.createElement('div');
          wrap.style.cssText = 'position:relative;display:inline-block;';
          wrap.innerHTML =
            '<img src="'+url+'" style="width:80px;height:80px;object-fit:cover;border-radius:12px;border:2px solid #e2e8f0"/>'+
            '<button type="button" style="position:absolute;top:-5px;right:-5px;background:#ef4444;color:#fff;border:none;border-radius:50%;width:20px;height:20px;font-size:11px;cursor:pointer;display:flex;align-items:center;justify-content:center" class="rm-img">×</button>';
          wrap.querySelector('.rm-img').addEventListener('click', function() {
            removedSet.push(url);
            if (removed) removed.value = JSON.stringify(removedSet);
            wrap.remove();
          });
          preview.appendChild(wrap);
        }

        input.addEventListener('change', function(e) {
          var newFiles   = Array.from(e.target.files || []);
          var currentCnt = preview.querySelectorAll('img').length;
          if (currentCnt + newFiles.length > 5) { alert('Tối đa 5 ảnh.'); input.value = ''; return; }
          newFiles.forEach(function(file) {
            dt.items.add(file);
            var reader = new FileReader();
            reader.onload = function() {
              var wrap = document.createElement('div');
              wrap.style.cssText = 'position:relative;display:inline-block;';
              var fn = file.name;
              wrap.innerHTML =
                '<img src="'+reader.result+'" style="width:80px;height:80px;object-fit:cover;border-radius:12px;border:2px solid #e2e8f0"/>'+
                '<button type="button" style="position:absolute;top:-5px;right:-5px;background:#ef4444;color:#fff;border:none;border-radius:50%;width:20px;height:20px;font-size:11px;cursor:pointer;display:flex;align-items:center;justify-content:center" class="rm-img">×</button>';
              wrap.querySelector('.rm-img').addEventListener('click', function() {
                var ndt = new DataTransfer();
                Array.from(dt.files).forEach(function(f){ if (f.name !== fn) ndt.items.add(f); });
                dt = ndt; input.files = dt.files; wrap.remove();
              });
              preview.appendChild(wrap);
            };
            reader.readAsDataURL(file);
          });
          input.files = dt.files;
        });

        return { addExistingImg: addExistingImg, reset: function() {
          preview.innerHTML = ''; dt = new DataTransfer(); removedSet = [];
          input.value = '';
          if (removed) removed.value = '[]';
        }};
      }

      var createImgCtl = initImgUpload('createImgInput', 'createImgPreview', null);
      var editImgCtl   = initImgUpload('editImgInput',   'editImgPreview',   'editRemovedImages');

      // ── Form validation
      function validateFeedbackForm(ratingInputId, contentId) {
        var rating  = Number(document.getElementById(ratingInputId).value);
        var content = document.getElementById(contentId).value.trim();
        if (!rating || rating < 1) { alert('Vui lòng chọn số sao!'); return false; }
        if (!content) { alert('Vui lòng nhập nội dung đánh giá!'); return false; }
        return true;
      }
      document.getElementById('createForm').addEventListener('submit', function(e) {
        if (!validateFeedbackForm('createRating','createContent')) e.preventDefault();
      });
      document.getElementById('editForm').addEventListener('submit', function(e) {
        if (!validateFeedbackForm('editRating','editContent')) e.preventDefault();
      });

      // ── Open CREATE modal
      document.querySelectorAll('.js-open-create').forEach(function(btn) {
        btn.addEventListener('click', function() {
          // Reset form
          document.getElementById('createRating').value = '0';
          document.getElementById('createTags').value   = '';
          document.getElementById('createContent').value = '';
          document.getElementById('createCharCount').textContent = '0/500';
          document.getElementById('createAnon').checked = false;
          document.getElementById('createTagGrid').querySelectorAll('.modal-tag-btn').forEach(function(b){ b.classList.remove('selected'); });
          if (setCreateStars) setCreateStars(0);
          if (createImgCtl) createImgCtl.reset();
          openModal('createModal');
        });
      });

      // ── Open VIEW modal
      document.querySelectorAll('.js-open-view').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var d     = btn.dataset;
          var rating = Number(d.rating);
          var images = JSON.parse(d.images || '[]');
          var tags   = d.tags ? d.tags.split(',').map(function(t){ return t.trim(); }).filter(Boolean) : [];

          // Avatar
          var av = document.getElementById('viewAvatar');
          av.textContent = (d.user && d.user.trim()) ? d.user.trim().charAt(0).toUpperCase() : 'U';

          document.getElementById('viewUserName').textContent = d.user || '—';
          document.getElementById('viewDate').textContent     = d.date || '—';

          // Stars
          var starsEl = document.getElementById('viewStars');
          starsEl.innerHTML = '';
          for (var i = 1; i <= 5; i++) {
            var svgNS = 'http://www.w3.org/2000/svg';
            var svg   = document.createElementNS(svgNS, 'svg');
            svg.setAttribute('viewBox','0 0 24 24');
            svg.setAttribute('width','22'); svg.setAttribute('height','22');
            svg.setAttribute('fill', i <= rating ? '#fbbf24' : '#e2e8f0');
            var path = document.createElementNS(svgNS, 'path');
            path.setAttribute('d','M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z');
            svg.appendChild(path); starsEl.appendChild(svg);
          }
          document.getElementById('viewStarText').textContent = rating + '/5 sao';

          // Tags
          var tagsSection = document.getElementById('viewTagsSection');
          var tagsEl      = document.getElementById('viewTags');
          tagsEl.innerHTML = '';
          if (tags.length > 0) {
            tagsSection.style.display = '';
            tags.forEach(function(tag) {
              var span = document.createElement('span');
              span.className = 'fb-tag-chip'; span.textContent = tag;
              tagsEl.appendChild(span);
            });
          } else { tagsSection.style.display = 'none'; }

          // Content
          document.getElementById('viewContent').textContent = d.content || '—';

          // Images
          var imgsSection = document.getElementById('viewImagesSection');
          var imgsEl      = document.getElementById('viewImages');
          imgsEl.innerHTML = '';
          if (images.length > 0) {
            imgsSection.style.display = '';
            images.forEach(function(url) {
              var img = document.createElement('img');
              img.src = url; img.alt = 'Ảnh đánh giá'; img.className = 'view-img-thumb';
              imgsEl.appendChild(img);
            });
          } else { imgsSection.style.display = 'none'; }

          // Wire "Chỉnh sửa" button → open edit with same data
          document.getElementById('viewEditSwitch').onclick = function() {
            closeModal('viewModal');
            // trigger edit open with same data
            var fakeBtn = document.createElement('button');
            fakeBtn.dataset.id     = d.id;
            fakeBtn.dataset.rating = d.rating;
            fakeBtn.dataset.content= d.content;
            fakeBtn.dataset.tags   = d.tags;
            fakeBtn.dataset.images = d.images;
            fakeBtn.dataset.anon   = d.anon;
            fakeBtn.classList.add('js-open-edit');
            openEditModal(fakeBtn);
          };

          openModal('viewModal');
        });
      });

      // ── Open EDIT modal
      function openEditModal(btn) {
        var d      = btn.dataset;
        var rating = Number(d.rating);
        var images = JSON.parse(d.images || '[]');
        var tags   = d.tags ? d.tags.split(',').map(function(t){ return t.trim(); }).filter(Boolean) : [];

        // Set form action
        document.getElementById('editForm').action = '/feedback/' + d.id + '/update';

        // Stars
        if (setEditStars) setEditStars(rating);

        // Tags
        document.getElementById('editTags').value = tags.join(', ');
        document.getElementById('editTagGrid').querySelectorAll('.modal-tag-btn').forEach(function(btn) {
          if (tags.indexOf(btn.dataset.tag) !== -1) btn.classList.add('selected');
          else btn.classList.remove('selected');
        });

        // Content
        var contentEl = document.getElementById('editContent');
        contentEl.value = d.content || '';
        document.getElementById('editCharCount').textContent = contentEl.value.length + '/500';

        // Anon
        document.getElementById('editAnon').checked = (d.anon === 'true');

        // Images
        if (editImgCtl) editImgCtl.reset();
        images.forEach(function(url) {
          if (editImgCtl) editImgCtl.addExistingImg(url);
        });

        openModal('editModal');
      }

      document.querySelectorAll('.js-open-edit').forEach(function(btn) {
        btn.addEventListener('click', function() { openEditModal(btn); });
      });
    });