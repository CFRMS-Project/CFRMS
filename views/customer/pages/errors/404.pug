extends ../../../layouts/blank.pug

block content
  .not-found-container(class="flex flex-col items-center justify-center min-h-screen bg-slate-900 text-white px-4 text-center")
    h1(class="text-[10rem] md:text-[16rem] lg:text-[20rem] font-extrabold tracking-tighter leading-none text-transparent bg-clip-text bg-gradient-to-br from-blue-400 to-purple-600 select-none drop-shadow-lg") 404
    h2(class="text-3xl md:text-5xl font-bold mt-4 mb-6 tracking-tight") Oops! Trang không tồn tại
    p(class="text-slate-400 mb-12 max-w-2xl text-base md:text-xl leading-relaxed") Đường dẫn bạn truy cập có thể đã bị thay đổi, xóa bỏ hoặc tạm thời không hoạt động. Hãy quay về trang chủ để tiếp tục khám phá nhé.
    a(href="/" class="group inline-flex items-center justify-center gap-3 px-8 py-4 md:px-10 md:py-5 bg-white text-slate-900 font-bold text-base md:text-lg rounded-2xl hover:bg-slate-900 hover:text-white border-2 border-white transition-all duration-300 shadow-[0_0_30px_rgba(255,255,255,0.2)] hover:shadow-blue-500/40 active:scale-95")
      svg(xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:-translate-x-2")
        path(d="m15 18-6-6 6-6")
      span Trở Về Trang Chủ