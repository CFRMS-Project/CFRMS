<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Viết đánh giá</title>
    <style>
        /* ===== Custom Styles cho Form Đánh giá ===== */

        /* Hiệu ứng hover cho ngôi sao rating */
        .star-btn {
            cursor: pointer;
            transition: transform 0.15s ease, color 0.15s ease;
        }

        .star-btn:hover {
            transform: scale(1.2);
        }

        .star-btn.active {
            color: #facc15;
            /* yellow-400 */
        }

        .star-btn.inactive {
            color: #d1d5db;
            /* gray-300 */
        }

        /* Thẻ đánh giá nhanh (Tag) */
        .tag-btn {
            transition: all 0.2s ease;
        }

        .tag-btn.selected {
            background-color: #2563eb;
            color: white;
            border-color: #2563eb;
        }

        /* Preview ảnh upload */
        .image-preview-item {
            position: relative;
        }

        .image-preview-item .remove-btn {
            position: absolute;
            top: -6px;
            right: -6px;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #ef4444;
            color: white;
            font-size: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            opacity: 0;
            transition: opacity 0.2s;
        }

        .image-preview-item:hover .remove-btn {
            opacity: 1;
        }

        /* Hiệu ứng nút Gửi */
        .submit-btn {
            transition: all 0.3s ease;
        }

        .submit-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.4);
        }
    </style>
</head>

<body class="bg-gray-50 flex justify-center items-start min-h-screen py-8">

    <!-- ===== Container chính ===== -->
    <div class="bg-white w-full max-w-2xl p-8 rounded-2xl shadow-lg">

        <!-- Header: Nút quay lại + Tiêu đề -->
        <div class="flex items-center justify-between mb-6">
            <div class="flex items-center">
                <a href="/history" class="text-gray-500 mr-4 hover:text-gray-700 text-xl">←</a>
                <h2 class="text-xl font-bold text-gray-800">Viết đánh giá</h2>
            </div>
            <span class="text-xs text-gray-400">ĐƠN HÀNG #SVN-2024</span>
        </div>

        <!-- ===== FORM ĐÁNH GIÁ ===== -->
        <!-- enctype="multipart/form-data" : bắt buộc để upload file ảnh -->
        <form action="/feedback" method="POST" enctype="multipart/form-data" id="feedbackForm">

            <!-- Thông tin sản phẩm -->
            <div class="flex items-center space-x-4 bg-gray-50 p-4 rounded-xl mb-6 border">
                <div class="w-16 h-16 bg-gray-800 rounded-lg overflow-hidden flex items-center justify-center">
                    <span class="text-2xl">💍</span>
                </div>
                <div>
                    <h4 class="font-bold text-gray-800">Nhẫn đính hôn Diamond Minimalis</h4>
                    <p class="text-xs text-gray-400">Phân loại: Vàng 18K - Size 12</p>
                </div>
            </div>

            <!-- ===== BỘ CHỌN RATING (Ngôi sao) ===== -->
            <!-- Giá trị rating được lưu trong hidden input -->
            <div class="text-center mb-6">
                <p class="font-bold text-lg mb-3 text-gray-800">Bạn thấy sản phẩm này thế nào?</p>

                <!-- Hidden input: chứa giá trị rating (1-5) để gửi lên server -->
                <input type="hidden" name="rating" id="ratingInput" value="0">

                <!-- 5 ngôi sao - JavaScript sẽ xử lý sự kiện click -->
                <div class="flex justify-center space-x-2 text-3xl" id="starContainer">
                    <span class="star-btn inactive" data-value="1">★</span>
                    <span class="star-btn inactive" data-value="2">★</span>
                    <span class="star-btn inactive" data-value="3">★</span>
                    <span class="star-btn inactive" data-value="4">★</span>
                    <span class="star-btn inactive" data-value="5">★</span>
                </div>

                <!-- Label hiển thị mô tả rating -->
                <p class="text-sm mt-2 font-medium" id="ratingLabel">
                    <span class="text-gray-400">Nhấn để đánh giá</span>
                </p>
            </div>

            <!-- ===== THẺ ĐÁNH GIÁ NHANH (Tags) ===== -->
            <!-- Các tag được chọn sẽ nối thành chuỗi gửi lên server -->
            <div class="mb-6">
                <p class="font-medium text-gray-700 mb-3 text-sm">Đánh giá nhanh</p>
                <input type="hidden" name="tags" id="tagsInput" value="">

                <div class="flex flex-wrap gap-2 justify-center" id="tagContainer">
                    <button type="button" class="tag-btn px-4 py-1.5 border rounded-full text-sm text-gray-600 hover:border-blue-500"
                        data-tag="Đúng mô tả">Đúng mô tả</button>
                    <button type="button" class="tag-btn px-4 py-1.5 border rounded-full text-sm text-gray-600 hover:border-blue-500"
                        data-tag="Giao hàng nhanh">Giao hàng nhanh</button>
                    <button type="button" class="tag-btn px-4 py-1.5 border rounded-full text-sm text-gray-600 hover:border-blue-500"
                        data-tag="Đóng gói kỹ">Đóng gói kỹ</button>
                    <button type="button" class="tag-btn px-4 py-1.5 border rounded-full text-sm text-gray-600 hover:border-blue-500"
                        data-tag="Chất lượng tuyệt vời">Chất lượng tuyệt vời</button>
                    <button type="button" class="tag-btn px-4 py-1.5 border rounded-full text-sm text-gray-600 hover:border-blue-500"
                        data-tag="Thái độ tốt">Thái độ tốt</button>
                </div>
            </div>

            <!-- ===== NỘI DUNG ĐÁNH GIÁ ===== -->
            <!-- Textarea với giới hạn 500 ký tự + bộ đếm -->
            <div class="mb-6">
                <p class="font-medium text-gray-700 mb-2 text-sm">Chia sẻ thêm về trải nghiệm</p>
                <div class="relative">
                    <textarea name="content" id="contentInput"
                        class="w-full border rounded-xl p-4 text-sm bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white resize-none transition"
                        rows="4" maxlength="500"
                        placeholder="Sản phẩm dùng rất tốt, ấm thanh trong trảo..."></textarea>
                    <!-- Bộ đếm ký tự -->
                    <span class="absolute bottom-3 right-3 text-xs text-gray-400" id="charCount">0/500</span>
                </div>
            </div>

            <!-- ===== TẢI LÊN HÌNH ẢNH ===== -->
            <!-- Input file multiple + preview ảnh trước khi gửi -->
            <div class="mb-6">
                <p class="font-medium text-gray-700 mb-2 text-sm">Hình ảnh & Video thực tế</p>

                <!-- Preview container -->
                <div class="flex flex-wrap gap-3 mb-3" id="imagePreview"></div>

                <!-- Nút chọn ảnh -->
                <label
                    class="inline-flex items-center px-4 py-2 border-2 border-dashed border-blue-300 rounded-xl text-sm text-blue-600 cursor-pointer hover:bg-blue-50 transition">
                    <span class="mr-2">📷</span>
                    Thêm ảnh/video
                    <!-- Input file: cho phép chọn nhiều ảnh, chỉ nhận ảnh -->
                    <input type="file" name="images" id="imageInput" multiple accept="image/jpeg,image/jpg,image/png"
                        class="hidden">
                </label>
                <p class="text-xs text-gray-400 mt-1">Tối đa 5 ảnh, mỗi ảnh ≤ 5MB (jpg, png)</p>
            </div>

            <!-- ===== CHẾ ĐỘ ẨN DANH ===== -->
            <div class="flex items-center space-x-2 text-sm text-gray-500 mb-6">
                <input type="checkbox" id="anonCheckbox" name="isAnonymous"
                    class="w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                <label for="anonCheckbox">Gửi đánh giá dưới tên ẩn danh</label>
            </div>

            <!-- ===== NÚT GỬI ===== -->
            <button type="submit"
                class="submit-btn w-full bg-blue-600 text-white font-bold py-3 rounded-xl hover:bg-blue-700 flex items-center justify-center space-x-2">
                <span>Gửi đánh giá ngay</span>
                <span>📝</span>
            </button>
        </form>

        <!-- Lưu ý chính sách -->
        <p class="text-xs text-gray-400 text-center mt-4">
            Bằng cách gửi đánh giá, bạn đồng ý với
            <a href="#" class="text-blue-500 hover:underline">Chính sách & Điều khoản</a>
            của ShopVN. Đánh giá sẽ được kiểm duyệt trước khi hiển thị.
        </p>
    </div>

    <!-- ===== JAVASCRIPT XỬ LÝ TƯƠNG TÁC ===== -->
    <script>
        /**
         * ===============================================
         * Script: Xử lý tương tác trên form đánh giá
         * ===============================================
         * 1. Star Rating: Click ngôi sao → cập nhật hidden input
         * 2. Tag Selection: Chọn/bỏ chọn tag → cập nhật hidden input
         * 3. Char Counter: Đếm ký tự textarea
         * 4. Image Preview: Xem trước ảnh khi chọn file
         * 5. Form Validation: Kiểm tra trước khi gửi
         * ===============================================
         */

        // === 1. BỘ CHỌN SAO (Star Rating) ===
        const stars = document.querySelectorAll('.star-btn');
        const ratingInput = document.getElementById('ratingInput');
        const ratingLabel = document.getElementById('ratingLabel');

        // Mô tả cho mỗi mức rating
        const ratingTexts = {
            1: { text: 'Tệ', color: 'text-red-500' },
            2: { text: 'Không hài lòng', color: 'text-orange-500' },
            3: { text: 'Bình thường', color: 'text-yellow-500' },
            4: { text: 'Tuyệt vời', color: 'text-blue-500' },
            5: { text: 'Xuất sắc', color: 'text-green-500' }
        };

        stars.forEach(star => {
            star.addEventListener('click', () => {
                const value = parseInt(star.dataset.value);
                ratingInput.value = value;

                // Cập nhật giao diện ngôi sao
                stars.forEach(s => {
                    if (parseInt(s.dataset.value) <= value) {
                        s.classList.remove('inactive');
                        s.classList.add('active');
                    } else {
                        s.classList.remove('active');
                        s.classList.add('inactive');
                    }
                });

                // Cập nhật label mô tả
                const info = ratingTexts[value];
                ratingLabel.innerHTML = `<span class="${info.color} font-medium">${info.text}</span>`;
            });
        });


        // === 2. THẺ ĐÁNH GIÁ NHANH (Tag Selection) ===
        const tagButtons = document.querySelectorAll('.tag-btn');
        const tagsInput = document.getElementById('tagsInput');
        const selectedTags = new Set();

        tagButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                const tag = btn.dataset.tag;

                if (selectedTags.has(tag)) {
                    // Bỏ chọn tag
                    selectedTags.delete(tag);
                    btn.classList.remove('selected');
                } else {
                    // Chọn tag
                    selectedTags.add(tag);
                    btn.classList.add('selected');
                }

                // Cập nhật hidden input: nối các tag bằng dấu phẩy
                // Ví dụ: "Giao nhanh, Đóng gói kỹ"
                tagsInput.value = Array.from(selectedTags).join(', ');
            });
        });


        // === 3. BỘ ĐẾM KÝ TỰ (Character Counter) ===
        const contentInput = document.getElementById('contentInput');
        const charCount = document.getElementById('charCount');

        contentInput.addEventListener('input', () => {
            const len = contentInput.value.length;
            charCount.textContent = `${len}/500`;

            // Đổi màu khi gần đạt giới hạn
            if (len >= 450) {
                charCount.classList.add('text-red-500');
                charCount.classList.remove('text-gray-400');
            } else {
                charCount.classList.remove('text-red-500');
                charCount.classList.add('text-gray-400');
            }
        });


        // === 4. PREVIEW ẢNH (Image Upload Preview) ===
        const imageInput = document.getElementById('imageInput');
        const imagePreview = document.getElementById('imagePreview');

        imageInput.addEventListener('change', (e) => {
            // Xóa preview cũ
            imagePreview.innerHTML = '';

            const files = e.target.files;

            // Kiểm tra số lượng file
            if (files.length > 5) {
                alert('Chỉ được upload tối đa 5 ảnh!');
                imageInput.value = '';
                return;
            }

            // Tạo preview cho từng file
            Array.from(files).forEach((file, index) => {
                const reader = new FileReader();

                reader.onload = (ev) => {
                    const div = document.createElement('div');
                    div.className = 'image-preview-item';
                    div.innerHTML = `
                        <img src="${ev.target.result}"
                             class="w-20 h-20 object-cover rounded-lg border"
                             alt="Preview ${index + 1}">
                        <span class="remove-btn" data-index="${index}">×</span>
                    `;
                    imagePreview.appendChild(div);
                };

                reader.readAsDataURL(file);
            });
        });


        // === 5. FORM VALIDATION ===
        document.getElementById('feedbackForm').addEventListener('submit', (e) => {
            const rating = parseInt(ratingInput.value);

            if (!rating || rating < 1) {
                e.preventDefault();
                alert('Vui lòng chọn số sao đánh giá!');
                return;
            }

            const content = contentInput.value.trim();
            if (!content) {
                e.preventDefault();
                alert('Vui lòng nhập nội dung đánh giá!');
                return;
            }
        });
    </script>
</body>

</html>
