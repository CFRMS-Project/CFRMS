doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Đánh giá sản phẩm - ShopVN
    script(src="https://cdn.tailwindcss.com")
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap", rel="stylesheet")
    style.
      body { font-family: 'Inter', sans-serif; }
      .custom-scrollbar::-webkit-scrollbar { width: 4px; }
      .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }

  body(class="bg-slate-50 text-slate-900 antialiased")
    main.feedback-wrapper(class="max-w-[640px] mx-auto my-10 px-4")
      
      //- Header
      header.feedback-header(class="flex items-center mb-8")
        a.back-btn(href="history.html" class="p-2 -ml-2 text-slate-500 hover:text-slate-900 transition-colors bg-white rounded-full shadow-sm border border-slate-100 mr-4")
          svg(xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
            line(x1="19" y1="12" x2="5" y2="12")
            polyline(points="12 19 5 12 12 5")
        div(class="flex-1")
          h1(class="text-lg font-bold text-slate-800") Viết đánh giá
          span.order-id(class="text-[10px] font-bold text-slate-400 uppercase tracking-widest") Đơn hàng #SVN2024

      //- Thông tin sản phẩm
      section.feedback-product(class="bg-white rounded-2xl p-4 flex items-center gap-5 mb-6 shadow-sm border border-slate-100")
        img(src="https://images.unsplash.com/photo-1605100804763-247f67b2548e?auto=format&fit=crop&q=80" alt="Nhẫn đính hôn" class="w-16 h-16 rounded-xl object-cover bg-slate-900 shadow-inner")
        .product-info
          h3(class="text-sm font-bold text-slate-800") Nhẫn đính hôn Diamond Minimalist
          p(class="text-xs text-slate-500 mt-1") Phân loại: Vàng 18K - Size 12

      //- Form Đánh giá
      form.feedback-form(action="#" class="bg-white rounded-[2rem] p-8 md:p-10 shadow-xl shadow-slate-200/50 border border-slate-100 mb-8")
        
        //- Rating Stars
        .rating-section(class="text-center mb-10")
          h2(class="text-xl font-extrabold text-slate-800 mb-6") Bạn thấy sản phẩm này thế nào?
          .stars(class="flex justify-center gap-3 mb-3")
            - for (var x = 0; x < 4; x++)
              svg.star(class="w-10 h-10 text-amber-400 cursor-pointer transition-transform hover:scale-110 active:scale-90" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor")
                polygon(points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2")
            svg.star(class="w-10 h-10 text-slate-200 cursor-pointer transition-transform hover:scale-110 active:scale-90" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
              polygon(points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2")
          span.rating-text(class="text-sm font-bold text-blue-600 tracking-wide uppercase") Tuyệt vời

        //- Media Upload
        .media-section(class="mb-8")
          h3(class="text-sm font-bold text-slate-700 mb-4") Hình ảnh & Video thực tế
          .media-grid(class="flex flex-wrap gap-3")
            .media-item(class="w-24 h-24 rounded-2xl overflow-hidden bg-slate-100 border border-slate-200 group relative cursor-zoom-in")
              img(src="https://images.unsplash.com/photo-1605100804763-247f67b2548e?auto=format&fit=crop&q=80" alt="Hình thực tế 1" class="w-full h-full object-cover transition-transform group-hover:scale-110")
            .media-item(class="w-24 h-24 rounded-2xl overflow-hidden bg-slate-100 border border-slate-200 group relative cursor-zoom-in")
              img(src="https://images.unsplash.com/photo-1605100804763-247f67b2548e?auto=format&fit=crop&q=80" alt="Hình thực tế 2" class="w-full h-full object-cover transition-transform group-hover:scale-110")
            
            label.media-upload(class="w-32 h-24 border-2 border-dashed border-blue-100 rounded-2xl flex flex-col items-center justify-center gap-2 text-blue-500 cursor-pointer bg-blue-50/30 hover:bg-blue-50 hover:border-blue-300 transition-all group")
              input(type="file" hidden multiple accept="image/*,video/*")
              svg(class="w-6 h-6 transition-transform group-hover:-translate-y-1" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2")
                path(stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z")
                path(stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z")
              span(class="text-[10px] font-bold uppercase tracking-tighter") Thêm ảnh/video

        //- Quick Tags
        .tags-section(class="mb-8")
          h3(class="text-sm font-bold text-slate-700 mb-4") Đánh giá nhanh
          .tags-container(class="flex flex-wrap gap-2")
            button.tag(type="button" class="px-5 py-2 rounded-full border border-blue-200 bg-blue-50 text-blue-600 text-xs font-bold shadow-sm shadow-blue-100 transition-all") Đúng mô tả
            each tag in ['Giao hàng nhanh', 'Đóng gói kỹ', 'Chất lượng tuyệt vời']
              button.tag(type="button" class="px-5 py-2 rounded-full border border-slate-200 text-slate-500 text-xs font-medium hover:border-slate-400 hover:text-slate-700 transition-all")= tag

        //- Text Review
        .comment-section(class="mb-8")
          h3(class="text-sm font-bold text-slate-700 mb-4") Chia sẻ thêm về trải nghiệm
          .textarea-wrapper(class="relative group")
            textarea(class="w-full min-h-[140px] p-5 bg-slate-50 border border-slate-100 rounded-2xl text-sm text-slate-800 outline-none focus:bg-white focus:ring-4 focus:ring-blue-500/5 focus:border-blue-500 transition-all resize-none placeholder:text-slate-400 custom-scrollbar" placeholder="Sản phẩm dùng rất tốt, vẻ ngoài lộng lẫy..." maxlength="500")
            span.char-count(class="absolute bottom-4 right-5 text-[10px] font-bold text-slate-300 group-focus-within:text-slate-400 uppercase tracking-widest") 0/500

        //- Anonymous Checkbox
        .anonymous-section(class="mb-10")
          label.checkbox-label(class="flex items-center gap-3 cursor-pointer group")
            div(class="relative flex items-center")
              input(type="checkbox" class="peer h-5 w-5 cursor-pointer appearance-none rounded-md border border-slate-300 transition-all checked:border-blue-500 checked:bg-blue-500 hover:border-blue-400")
              svg(class="absolute h-3.5 w-3.5 text-white opacity-0 transition-opacity peer-checked:opacity-100 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="4")
                path(stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7")
            span(class="text-xs font-medium text-slate-500 group-hover:text-slate-800 transition-colors") Gửi đánh giá dưới tên ẩn danh

        //- Submit
        button.btn-submit-review(type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-4 rounded-2xl font-bold text-sm shadow-xl shadow-blue-500/30 flex items-center justify-center gap-3 transition-all active:scale-[0.98]")
          span Gửi đánh giá ngay
          svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
            line(x1="22" y1="2" x2="11" y2="13")
            polygon(points="22 2 15 22 11 13 2 9 22 2")

      //- Footer Note
      .feedback-footer-text(class="text-center pb-10 px-6")
        p(class="text-[11px] text-slate-400 leading-relaxed max-w-sm mx-auto uppercase tracking-tighter font-medium") Bằng cách gửi đánh giá, bạn đồng ý với #[a(href="#" class="text-blue-500 font-bold hover:underline") Điều khoản & Chính sách] của ShopVN. Đánh giá của bạn sẽ giúp cộng đồng mua sắm tốt hơn.