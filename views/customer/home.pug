extends ../layouts/customer.pug

block head
  title Trang chủ - ShopVN
  link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet")
  style.
    body { font-family: 'Inter', sans-serif; }

block content
  main.home-content(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8")
    
    //- ================= HERO BANNER =================
    section.hero-banner(class="relative rounded-[2rem] overflow-hidden min-h-[500px] flex items-center p-8 md:p-16 mb-16 shadow-2xl")
      img(src="https://res.cloudinary.com/dsaq5kgkg/image/upload/c_fit,w_1000,h_1000,q_auto,f_auto/v1774021676/SSA377J1-1_biw7lw.png" class="absolute inset-0 w-full h-full object-cover")
      .overlay(class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/40 to-transparent z-10")
      
      .hero-content(class="relative z-20 max-w-xl")
        .badge(class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md border border-white/20 px-4 py-2 rounded-full mb-8")
          span.dot(class="w-2 h-2 bg-blue-500 rounded-full animate-pulse")
          span(class="text-white text-xs font-bold tracking-[0.2em]") BST MỚI 2024
        
        h1(class="text-4xl md:text-6xl font-extrabold text-white leading-[1.1] mb-6 tracking-tight uppercase")
          | PHONG CÁCH MỚI,#[br]
          span.highlight(class="text-blue-500") KHẲNG ĐỊNH
          |  TÔI
        
        p(class="text-slate-300 text-base md:text-lg mb-10 leading-relaxed") Nâng tầm phong cách cá nhân với bộ sưu tập phụ kiện xa xỉ, từ những chiếc đồng hồ tinh xảo đến trang sức lộng lẫy.
        
        .hero-actions(class="flex flex-wrap gap-4")
          a.btn-primary(href="/feedback/product/1" class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-4 rounded-xl font-bold text-sm transition-all shadow-lg shadow-blue-500/25 active:scale-95") MUA NGAY
          button.btn-outline(class="bg-white/10 hover:bg-white/20 backdrop-blur-sm border border-white/30 text-white px-8 py-4 rounded-xl font-bold text-sm transition-all active:scale-95") KHÁM PHÁ BST

    //- ================= DANH MỤC NỔI BẬT =================
    section.featured-categories(class="mb-20")
      .section-header(class="flex flex-col sm:flex-row justify-between items-end gap-4 mb-10")
        .title-group
          h2(class="text-3xl font-extrabold text-slate-800 tracking-tight") Danh Mục Nổi Bật
          p(class="text-slate-500 mt-2") Khám phá thế giới phụ kiện đẳng cấp
        a.view-all(href="#" class="flex items-center gap-2 text-blue-600 font-bold text-sm hover:gap-3 transition-all")
          span Xem tất cả
          svg(xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
            line(x1="5" y1="12" x2="19" y2="12")
            polyline(points="12 5 19 12 12 19")
      
      .category-grid(class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6")
        mixin catCard(img, name)
          a.category-card(href="#" class="group relative rounded-2xl overflow-hidden aspect-[4/5] bg-slate-100")
            img(src=img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110")
            .overlay(class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-80 transition-opacity group-hover:opacity-100")
            span.category-name(class="absolute bottom-6 left-6 text-white font-bold text-lg md:text-xl transform transition-transform group-hover:-translate-y-2")= name
        
        +catCard("https://res.cloudinary.com/dsaq5kgkg/image/upload/c_thumb,g_auto,w_600,h_800,q_auto,f_auto/v1774021075/Seiko-Prospex-PDM2_nvcjp5.png", "Đồng Hồ")
        +catCard("https://res.cloudinary.com/dsaq5kgkg/image/upload/c_thumb,g_auto,z_0.8,w_600,h_800,q_auto,f_auto/v1774021121/tui1_i0hsao.png", "Túi Xách")
        +catCard("https://res.cloudinary.com/dsaq5kgkg/image/upload/c_thumb,g_auto,z_1,w_600,h_800,q_auto,f_auto/v1774021092/nhan5_wambt7.png", "Trang Sức")
        +catCard("https://res.cloudinary.com/dsaq5kgkg/image/upload/c_fill,g_center,w_600,h_800,q_auto,f_auto/v1774021116/kinh-nam-2_o65za8.jpg", "Kính Mát")

    //- ================= ĐĂNG KÝ NHẬN TIN =================
    section.newsletter-section(class="bg-blue-50 rounded-[2rem] p-8 md:p-16 flex flex-col lg:flex-row items-center justify-between gap-12")
      .newsletter-content(class="lg:max-w-md")
        h3(class="text-3xl font-extrabold text-slate-800 mb-4") Nhận Tin Ưu Đãi
        p(class="text-slate-600 leading-relaxed") Đăng ký để nhận thông báo sớm nhất về các bộ sưu tập giới hạn và ưu đãi độc quyền dành riêng cho thành viên.
      
      .newsletter-form(class="w-full max-w-md")
        form(action="#" class="flex flex-col sm:flex-row gap-3 mb-4")
          input(type="email" placeholder="Địa chỉ email của bạn" required class="flex-grow px-6 py-4 rounded-xl border-none focus:ring-2 focus:ring-blue-500 outline-none shadow-sm shadow-blue-100")
          button.btn-primary(type="submit" class="bg-slate-900 hover:bg-black text-white px-8 py-4 rounded-xl font-bold transition-all active:scale-95 shadow-lg shadow-slate-200") Đăng Ký
        p.terms(class="text-[11px] text-slate-400 text-center sm:text-left uppercase tracking-wider font-semibold") Bằng cách đăng ký, bạn đồng ý với Chính sách bảo mật của chúng tôi.